# opencode paketi — ortam degiskenleri SABLONU (gercek degerler bu dosyada YOK)
#
# `env` dosyasi elle olusturulmaz: ./kur.sh, env yoksa once env.local'i, o da yoksa
# bu sablonu `env` adiyla kopyalar (izin 600) — elle kopyalama adimi YOKTUR.
# Yani gercek saha degerlerinin yeri: `env` ya da `env.local` (ikisi de .gitignore'da,
# tercih sirasi: env > env.local > env.example). Bu sablon bilerek repoda izlenir ve
# yalniz YER TUTUCU tasir — kurum adresi/anahtari repoya GIRMEZ.
#
# Bu sablondan uretilen `env` ile ./kur.sh calismaz: asagidaki yer tutuculari gercek
# degerlerle degistir (`./kur.sh kontrol` doldurulmamis sablonu yakalar ve uyarir).

# Kurumun OpenAI uyumlu koku (/v1 ile biter, sonda / OLMASIN)
# <kurum-uc> yerine gercek adresi yaz — ornek bicim: https://<kurum-host>/inference/<model>/v1
KURUM_URL="https://KURUM_ENDPOINT/v1"

# Uc kimlik dogrulamasi — gercek anahtari kurumdan al, *** ile degistir
KURUM_KEY=***

# Model kimligi (/v1/models ciktisindaki ad)
MODEL_ID=MODEL_ID_YER_TUTUCU

# OPSIYONEL — IKINCI UC (karsilastirma). KURUM_URL_2'yi doldurursan ./kur.sh kontrol
# raporunun sonuna 3 satir ekler: iki ucu yan yana olcer (erisim · model listede mi ·
# baglam penceresi · 3 olcumun medyan gecikmesi) ve "daha hizli hangisi" satirini basar.
# Bos birakirsan rapor eskisi gibi kalir. Olcum en kucuk istekle (/v1/models) yapilir,
# anahtar ekrana basilmaz. KURUM_KEY_2 bos ise KURUM_KEY, MODEL_ID_2 bos ise MODEL_ID
# kullanilir. (2. ucun gercek adresi bilerek yazilmadi — kurumdan al.)
# KURUM_URL_2=
# KURUM_KEY_2=
# MODEL_ID_2=

# OPSIYONEL — baglam penceresi (token). ./kur.sh kurulum sirasinda ${KURUM_URL%/}/models'e
# sorup max_model_len/context_length/max_context_length/context_window alanlarindan otomatik
# tespit etmeye calisir. Uc bu bilgiyi vermiyorsa ya da kurulum aninda ag yoksa, burada
# birakirsan (yorum satirini kaldirip doldurursan) o deger kullanilir. Ikisi de yoksa
# opencode.json'daki mevcut deger korunur ve ./kur.sh "pencere tespit edilemedi" uyarisi verir.
# KURUM_MAX_CONTEXT=32768
