      "df": "allow",
      "df *": "allow",
      "du": "allow",
      "du *": "allow",
      "free": "allow",
      "free *": "allow",
      "ps": "allow",
      "ps *": "allow",
      "ss": "allow",
      "ss *": "allow",
      "pvs": "allow",
      "pvs *": "allow",
      "vgs": "allow",
      "vgs *": "allow",
      "lvs": "allow",
      "lvs *": "allow",
      "lsblk": "allow",
      "lsblk *": "allow",
      "blkid": "allow",
      "blkid *": "allow",
      "journalctl": "allow",
      "journalctl *": "allow",
      "hostname": "allow",
      "hostname -f": "allow",
      "hostname -s": "allow",
      "hostname -i": "allow",
      "hostname -I": "allow",
      "hostname -d": "allow",
      "hostname -A": "allow",
      "hostname --fqdn": "allow",
      "date": "allow",
