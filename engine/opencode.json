{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "model": "kurum/qwen3.6-35b-a3b",
  "default_agent": "build",
  "agent": {
    "plan": {
      "permission": {
        "edit": "deny",
        "bash": "deny"
      }
    }
  },
  "provider": {
    "kurum": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Kurum Qwen (iç ağ)",
      "options": {
        "baseURL": "http://KURUM_ENDPOINT:PORT/v1",
        "apiKey": "kurum-anahtari",
        "timeout": 900000,
        "headerTimeout": 300000,
        "chunkTimeout": 180000
      },
      "models": {
        "qwen3.6-35b-a3b": {
          "id": "MODEL_ID_YER_TUTUCU",
          "name": "Qwen3.6-35B-A3B-FP8 (kurum)",
          "tool_call": true,
          "reasoning": false,
          "attachment": false,
          "limit": {
            "context": 16384,
            "output": 4096
          }
        }
      }
    }
  },
  "permission": {
    "skill": {
      "*": "allow"
    },
    "bash": {
      "*": "ask",
      "ls": "allow",
      "ls *": "allow",
      "wc": "allow",
      "wc *": "allow",
      "file": "allow",
      "file *": "allow",
      "stat": "allow",
