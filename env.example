# opencode paketi — ortam degiskenleri (SABLON — gercek degerleri sen doldur)
# Kullanim:  cp env.example env
# NOT: bu dosya .gitignore'da — kurum adresi/anahtar repoya GIRMEZ.

# Kurumun OpenAI uyumlu koku (/v1 ile biter, sonda / OLMASIN)
KURUM_URL=https://SUNUCU:8000/v1

# Uc kimlik dogrulamasi istemiyor → yer tutucu yeter
KURUM_KEY=dummy

# Model kimligi (/v1/models ciktisindaki ad)
MODEL_ID=MODEL_ID_YER_TUTUCU

# OPSIYONEL — bağlam penceresi (token). 02-kur.sh kurulum sırasında ${KURUM_URL%/}/models'e
# sorup max_model_len/context_length/max_context_length/context_window alanlarından otomatik
# tespit etmeye çalışır. Uç bu bilgiyi vermiyorsa ya da kurulum anında ağ yoksa, burada
# bırakırsan (yorum satırını kaldırıp doldurursan) o değer kullanılır. İkisi de yoksa
# opencode.json'daki mevcut değer korunur ve 02-kur.sh "pencere tespit edilemedi" uyarısı verir.
# KURUM_MAX_CONTEXT=32768
